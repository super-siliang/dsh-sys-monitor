{
  "name": "dsh-sys-monitor",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "btop 风格的本机系统监控：在 DeepSeek Harness 网页中实时查看 CPU、内存、磁盘、网络与进程，支持应用图标与强制退出进程。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "main": "./index.js",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "system-monitor",
    "btop",
    "process-monitor",
    "cpu",
    "memory",
    "network"
  ],
  "author": "Andy Zheng",
  "license": "MIT",
  "homepage": "https://github.com/m430/dsh-sys-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m430/dsh-sys-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/m430/dsh-sys-monitor/issues"
  },
  "engines": {
    "node": ">=20.11",
    "dsh": ">=0.1.0-0"
  },
  "publishConfig": {
    "access": "public"
  }
}
